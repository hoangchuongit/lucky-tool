<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<targets>
		<!-- Log chính: Info trở lên -->
		<target name="logfile" xsi:type="File"
				fileName="${basedir}/logs/log_${shortdate}_${hour}.log"
				layout="${longdate} ${uppercase:${level}} ${message}"
				archiveNumbering="Sequence"
				maxArchiveFiles="24"
				archiveEvery="Hour"
				encoding="utf-8" />

		<!-- Raw modem: mọi byte từ serial port, tách file riêng để dễ debug -->
		<target name="modemraw" xsi:type="File"
				fileName="${basedir}/logs/modem_${shortdate}_${hour}.log"
				layout="${longdate} ${message}"
				archiveNumbering="Sequence"
				maxArchiveFiles="48"
				archiveEvery="Hour"
				encoding="utf-8" />
	</targets>
	<rules>
		<!-- Raw modem logger — phải đứng TRƯỚC rule wildcard để không bị lọc -->
		<logger name="ModemRaw" minlevel="Trace" writeTo="modemraw" final="true" />
		<!-- Log chính: Info trở lên -->
		<logger name="*" minlevel="Info" writeTo="logfile" />
	</rules>
</nlog>