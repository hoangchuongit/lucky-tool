<?xml version="1.0" encoding="utf-8"?>
<!--
  HƯỚNG DẪN:
    1. Copy file này thành secrets.config (cùng thư mục với LuckCheck.exe)
    2. Điền các giá trị thực theo hướng dẫn bên dưới
    3. secrets.config KHÔNG được commit lên git

  GENERATE KEYS (chạy trên máy deploy, PowerShell):
    [Convert]::ToBase64String((1..32 | % { [byte](Get-Random -Max 256) }))
  Hoặc nếu có OpenSSL:
    openssl rand -base64 32
-->
<appSettings>

  <!-- ── Cấu hình server ── -->

  <!-- Port HTTP server lắng nghe. Go backend kết nối vào đây. -->
  <add key="GsmApiPort"     value="8000" />

  <!--
    GsmApiBindHost:
      localhost  = chỉ nhận kết nối từ cùng máy (dev)
      +          = nhận từ mọi interface (production / frp tunnel)
                   Cần chạy 1 lần với quyền Admin:
                   netsh http add urlacl url=http://+:8000/ user=Everyone
  -->
  <add key="GsmApiBindHost" value="localhost" />

  <!-- ID gateway này — phải khớp với gateway_id bên Go Backend -->
  <add key="GatewayId"      value="gw-001" />

  <!-- URL gốc Go Backend để nhận webhook (bỏ trống = tắt webhook) -->
  <add key="WebhookBaseUrl" value="" />

  <!-- Provider code xuất hiện trong URL webhook -->
  <add key="ProviderCode"   value="default" />

  <!-- ── Secrets — PHẢI điền trước khi chạy production ── -->

  <!--
    PinMasterKey — mã hoá PIN thẻ cào (AES-256-CBC + HMAC-SHA256)
    • Generate: openssl rand -base64 32
    • Phải khớp với PIN_MASTER_KEY trong .env Go Backend
    • Rotate mỗi 90 ngày hoặc khi có nhân viên nghỉ việc
  -->
  <add key="PinMasterKey"    value="REPLACE_WITH_GENERATED_KEY" />

  <!--
    ApiSharedSecret — xác thực request từ Go Backend (HMAC-SHA256 + timestamp ±300s)
    • Generate: openssl rand -base64 32
    • Phải khớp với GSM_SHARED_SECRET trong .env Go Backend
    • Để trống = xác thực BỊ TẮT (localhost/dev only)
  -->
  <add key="ApiSharedSecret" value="REPLACE_WITH_GENERATED_KEY" />

  <!--
    WebhookSecret — ký webhook gửi đến Go Backend
    • Generate: openssl rand -base64 32
    • Phải khớp với WEBHOOK_SECRET trong .env Go Backend
  -->
  <add key="WebhookSecret"   value="REPLACE_WITH_GENERATED_KEY" />

</appSettings>
